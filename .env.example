# PostgreSQL connection string from Neon or another PostgreSQL host.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Long random server-only key used by every public assessment API route.
# Do NOT name this NEXT_PUBLIC_* and never expose it in browser code.
KOYA_API_KEY=replace-with-a-long-random-secret

# Optional. Used only for server-side UI -> API calls. Local default should be http://localhost:3000.
# In Vercel, set this to the deployed site's HTTPS origin if needed.
APP_BASE_URL=http://localhost:3000

# Optional. Dedicated, disposable PostgreSQL database for integration tests only.
# Never point destructive integration tests at production.
DATABASE_URL_TEST=
